# Credenciales de una aplicación creada en https://dev.kick.com
# Configúralas solo en el servidor; nunca en el navegador ni en Git.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
PORT=3000
# Origen web autorizado, si se aloja en un dominio separado (sin barra final).
# Puedes indicar varios orígenes separados por coma.
APP_ORIGIN=
# Mantener false hasta proteger el endpoint y verificar límites del despliegue.
VODX_ENABLE_DOWNLOADS=false
TEMP_DIR=/tmp/vodx
FILE_RETENTION_MS=21600000
